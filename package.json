{
  "name": "harness",
  "version": "0.1.0",
  "description": "Agentic harness for solo founders — runs Copilot agent personas + own agents on any model via ModelHitch, in an OpenTUI terminal.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "bridge": "bun run src/bridge.ts",
    "typecheck": "bunx tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts",
    "tools:test": "bun run scripts/tools-test.ts",
    "tools:docs": "bun run scripts/docs-test.ts",
    "tools:coding": "bun run scripts/coding-test.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@opentui/core": "latest",
    "@strands-agents/sdk": "latest",
    "cross-spawn": "^7.0.6",
    "just-bash": "^3.4.0",
    "modelhitch": "latest",
    "openai": "^7.5.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
